# Copy to mobile/apps/mobile/.env for local `expo start`.
# Expo only reads .env from this directory (not repo root, not mobile/).

# Canonical Vercel/Neon API (map, detail, auth, claim). Defaults to production if unset.
EXPO_PUBLIC_API_BASE_URL=https://www.proteinoutfitters.com

# Optional — only needed for custom processing *request* submits until
# POST /api/processor-requests exists. Auth, claim, map, and detail use Neon.
EXPO_PUBLIC_SUPABASE_URL=https://unybunaqyqrxhfyhvhfo.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=paste_anon_public_key

# Injected by app.config.js → android.config.googleMaps.apiKey
GOOGLE_MAPS_ANDROID_KEY=paste_android_maps_key
