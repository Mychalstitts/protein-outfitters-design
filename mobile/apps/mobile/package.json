{
  "name": "@protein-outfitters/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "build:preview": "eas build --profile preview",
    "build:production": "eas build --profile production",
    "update:development": "eas update --channel development --non-interactive",
    "update:preview": "eas update --channel preview --non-interactive",
    "update:production": "eas update --channel production --non-interactive",
    "submit:ios": "eas submit -p ios",
    "submit:android": "eas submit -p android",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@protein-outfitters/shared": "*",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@supabase/supabase-js": "^2.43.4",
    "expo": "~51.0.0",
    "expo-apple-authentication": "~6.4.1",
    "expo-build-properties": "^0.12.5",
    "expo-constants": "~16.0.1",
    "expo-font": "~12.0.5",
    "expo-linking": "~6.3.1",
    "expo-location": "~17.0.1",
    "expo-router": "~3.5.14",
    "expo-splash-screen": "~0.27.4",
    "expo-status-bar": "~1.12.1",
    "expo-updates": "^0.25.28",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.1",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-maps": "1.14.0",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.1",
