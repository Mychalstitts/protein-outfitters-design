# Copy to mobile/.env for local `expo start`. Expo only reads .env files from
# the app directory (this folder), NOT from the repo root.
# For EAS builds these must be EAS secrets / env vars instead of a file.

EXPO_PUBLIC_SUPABASE_URL=https://unybunaqyqrxhfyhvhfo.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=paste_anon_public_key

# Android only — Maps SDK key, restricted to com.proteinoutfitters.app + SHA-1
GOOGLE_MAPS_ANDROID_KEY=paste_android_maps_key
