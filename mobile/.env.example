# Nested workspace env examples.
# Expo only reads .env from the app directory — copy the EXPO_* block to:
#   mobile/apps/mobile/.env
# For EAS builds, set the same names as EAS secrets / env vars (not a file).

# --- used by mobile/scripts (seed, check-env) ---
SUPABASE_URL=https://unybunaqyqrxhfyhvhfo.supabase.co
SUPABASE_ANON_KEY=paste_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=paste_service_role_key_local_only

# --- used by Expo (also in apps/mobile/.env.example) ---
EXPO_PUBLIC_SUPABASE_URL=https://unybunaqyqrxhfyhvhfo.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=paste_anon_public_key

# Android Maps SDK — restrict to com.proteinoutfitters.app + SHA-1; rotate if
# this value ever lived in app.json / git history.
GOOGLE_MAPS_ANDROID_KEY=paste_android_maps_key
