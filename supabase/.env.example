# Supabase — environment template. Copy to .env and fill in real values.
# Get keys from https://supabase.com/dashboard/project/unybunaqyqrxhfyhvhfo/settings/api-keys

# Public Supabase endpoint — safe to expose in frontend bundles
SUPABASE_URL=https://unybunaqyqrxhfyhvhfo.supabase.co

# Publishable key — safe to expose in frontend bundles. New format starts with sb_publishable_*
SUPABASE_ANON_KEY=sb_publishable_xxx_replace_me

# Secret key — server-side only, NEVER commit, NEVER expose in frontend. New format starts with sb_secret_*
# Used by seed scripts and any backend code that needs to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx_replace_me

# Mirror keys for Next.js (NEXT_PUBLIC_) and Expo (EXPO_PUBLIC_) prefixes if either is in use
NEXT_PUBLIC_SUPABASE_URL=https://unybunaqyqrxhfyhvhfo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx_replace_me

# Resend — only needed if calling Resend directly from this folder
# (Edge Functions already have their own RESEND_API_KEY set in Supabase secrets)
# RESEND_API_KEY=re_xxx_replace_me
