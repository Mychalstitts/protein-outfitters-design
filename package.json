{
  "name": "protein-outfitters-design",
  "version": "1.0.0",
  "private": true,
  "description": "Protein Outfitters — canonical site (deploy/), Supabase backend, shared package, and Expo mobile app",
  "workspaces": [
    "mobile",
    "packages/*"
  ],
  "scripts": {
    "validate:jsonld": "node scripts/validate-jsonld.js",
    "check:no-dupe-decls": "node scripts/check-no-dupe-decls.js",
    "lint": "node scripts/lint.js",
    "test:unit": "node --test test/harvest-label.test.mjs test/stittsworth-harvest.test.mjs test/connect-split.test.mjs",
    "test:auth": "node scripts/test-auth-retry.mjs",
    "test:auth:once": "node --test test/auth/*.test.mjs test/connect-onboarding.test.mjs test/connect-split.test.mjs test/harvest-label.test.mjs test/stittsworth-harvest.test.mjs",
    "test": "npm run lint && npm run test:unit && npm run test:auth",
    "mobile": "npm run start --workspace mobile",
    "mobile:ios": "npm run ios --workspace mobile",
    "mobile:android": "npm run android --workspace mobile",
    "mobile:typecheck": "npm run typecheck --workspace mobile",
    "mobile:bundle-data": "node scripts/mobile/bundle-data.mjs",
    "mobile:build-icons": "node scripts/mobile/build-icons.mjs",
    "shared:typecheck": "npm run typecheck --workspace packages/shared",
    "shared:test": "npm test --workspace packages/shared",
    "typecheck": "npm run shared:typecheck && npm run mobile:typecheck"
  },
  "devDependencies": {
    "cheerio": "^1.0.0",
    "@types/node": "^20.12.7",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.10.0",
    "npm": ">=10.0.0"
  }
}
