{
  "name": "Protein Outfitters",
  "short_name": "Protein Outfitters",
  "description": "Reserve a fraction of a real, named animal from a verified producer. Pick the cuts. We handle every step from drop-off to driveway.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui", "browser"],
  "orientation": "portrait",
  "background_color": "#fbf9f5",
  "theme_color": "#061b0e",
  "lang": "en-US",
  "dir": "ltr",
  "categories": ["food", "shopping", "lifestyle"],
  "icons": [
    { "src": "/brand/po-icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/brand/po-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/brand/po-icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/brand/po-icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/brand/favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Reserve an animal", "short_name": "Reserve", "url": "/discover", "icons": [{ "src": "/brand/po-icon-192.png", "sizes": "192x192" }] },
    { "name": "My account",        "short_name": "Account", "url": "/account",  "icons": [{ "src": "/brand/po-icon-192.png", "sizes": "192x192" }] },
    { "name": "Live map",          "short_name": "Map",     "url": "/map",      "icons": [{ "src": "/brand/po-icon-192.png", "sizes": "192x192" }] }
  ],
  "screenshots": [
    { "src": "/brand/screenshot-home-mobile.png", "sizes": "1080x1920", "type": "image/png", "form_factor": "narrow", "label": "Home — A whole animal in three taps" },
    { "src": "/brand/screenshot-discover-mobile.png", "sizes": "1080x1920", "type": "image/png", "form_factor": "narrow", "label": "Discover real animals from real farms" },
    { "src": "/brand/screenshot-map-mobile.png", "sizes": "1080x1920", "type": "image/png", "form_factor": "narrow", "label": "Live map of every farm and processor" }
  ],
  "related_applications": [],
  "prefer_related_applications": false
}
