{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
        {
            "source": "/farm/:slug([^/.]+)",
            "destination": "/api/farm-meta?slug=:slug"
        },
        {
            "source": "/p/:slug([^/.]+)",
            "destination": "/api/processor-meta?slug=:slug"
        },
        {
            "source": "/smokehouse/schedule",
            "destination": "/plant-desk"
        }
    ],
    "redirects": [
        {
            "source": "/:path*",
            "has": [
                {
                    "type": "host",
                    "value": "protein-outfitters-app1.vercel.app"
                }
            ],
            "destination": "https://www.proteinoutfitters.com/:path*",
            "permanent": false
        },
        {
            "source": "/:path*",
            "has": [
                {
                    "type": "host",
                    "value": "protein-outfitters-design-3nci.vercel.app"
                }
            ],
            "destination": "https://www.proteinoutfitters.com/:path*",
            "permanent": false
        },
        {
            "source": "/:path*",
            "has": [
                {
                    "type": "host",
                    "value": "protein-outfitters-design-ycmd.vercel.app"
                }
            ],
            "destination": "https://www.proteinoutfitters.com/:path*",
            "permanent": false
        },
        {
            "source": "/produced",
            "destination": "/producers",
            "permanent": true
        },
        {
            "source": "/farmer",
            "has": [
                {
                    "type": "query",
                    "key": "booking",
                    "value": "(?<booking>.+)"
                }
            ],
            "destination": "/booking-confirmation?booking=:booking",
            "permanent": false
        },
        {
            "source": "/r/:code",
            "destination": "/?ref=:code",
            "permanent": false
        },
        {
            "source": "/find-processors",
            "destination": "/map",
            "permanent": false
        },
        {
            "source": "/find-processors/:path*",
            "destination": "/map",
            "permanent": false
        },
        {
            "source": "/find-suppliers",
            "destination": "/discover",
            "permanent": false
        },
        {
            "source": "/find-suppliers/:path*",
            "destination": "/discover",
            "permanent": false
        },
        {
            "source": "/admin/opportunities",
            "destination": "/trends",
            "permanent": false
        },
        {
            "source": "/saved",
            "destination": "/account",
            "permanent": false
        },
        {
            "source": "/legal/privacy",
            "destination": "/policies/privacy",
            "permanent": false
        },
        {
            "source": "/legal/terms",
            "destination": "/policies/terms",
            "permanent": false
        },
        {
            "source": "/privacy",
            "destination": "/policies/privacy",
            "permanent": false
        },
        {
            "source": "/terms",
            "destination": "/policies/terms",
            "permanent": false
        },
        {
            "source": "/become-a-host",
            "destination": "/join",
            "permanent": true
        },
        {
            "source": "/for-producers",
            "destination": "/join?as=producer",
            "permanent": false
        },
        {
            "source": "/for-processors",
            "destination": "/join?as=processor",
            "permanent": false
        },
        {
            "source": "/partners",
            "destination": "/join",
            "permanent": false
        },
        {
            "source": "/associations",
            "destination": "/for-associations",
            "permanent": true
        },
        {
            "source": "/cattlemen",
            "destination": "/for-associations",
            "permanent": false
        }
    ],
    "crons": [
        {
            "path": "/api/email-tick",
            "schedule": "0 14 * * *"
        },
        {
            "path": "/api/annual-donor-acknowledgment",
            "schedule": "0 15 15 1 *"
        },
        {
            "path": "/api/cron-geocode",
            "schedule": "30 14 * * *"
        },
        {
            "path": "/api/cron-sweep-pending",
            "schedule": "*/15 * * * *"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Frame-Options",
                    "value": "SAMEORIGIN"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                }
            ]
        },
        {
            "source": "/theme.css",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=3600, must-revalidate"
                }
            ]
        },
        {
            "source": "/.well-known/apple-app-site-association",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "application/json"
                },
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=3600"
                }
            ]
        },
        {
            "source": "/.well-known/assetlinks.json",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "application/json"
                },
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=3600"
                }
            ]
        }
    ]
}